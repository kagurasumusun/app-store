            "value": "グリーン"
          }
        }
      }
    },
    "Health & Fitness": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケア／フィットネス"
          }
        }
      }
    },
    "IPAShelf downloads App Store packages with your own Apple ID, including older versions, and installs them on this device. Sign-in is protected by a complete in-app implementation of Apple's SAP signing protocol — no servers, no private frameworks.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPAShelfはあなた自身のApple IDでApp Storeのパッケージ（旧バージョン含む）をダウンロードし、このデバイスにインストールします。サインインはAppleのSAP署名プロトコルの完全なアプリ内実装で保護されており、サーバーもプライベートフレームワークも使いません。"
          }
        }
      }
    },
    "Import": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む"
          }
        }
      }
    },
    "Import an IPA": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPAを読み込む"
          }
        }
      }
    },
